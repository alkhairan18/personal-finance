APP_NAME="Buku Kas Pribadi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Konfigurasi opsional jika ingin menghubungkan server Laravel ke PostgreSQL Supabase:
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_SSLMODE=require
